<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:imvizui="clr-namespace:Bonsai.ImGui.Visualizers;assembly=Bonsai.ImGui.Visualizers.Design"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:ui="clr-namespace:Bonsai.Design;assembly=Bonsai.Design"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="SubscribeSubject">
        <Name>PlotFrame</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>DigitalState</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>IsSynchronized</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:DigitalStateVisualizer">
          <p1:Visible>true</p1:Visible>
          <p1:FontSize>24</p1:FontSize>
          <p1:WindowSeconds>10</p1:WindowSeconds>
          <p1:HeightFraction>0.4</p1:HeightFraction>
        </Combinator>
      </Expression>
      <Expression xsi:type="imvizui:ImGuiVisualizerBuilder" />
      <Expression xsi:type="rx:PublishSubject">
        <Name>FormFrame</Name>
      </Expression>
      <Expression xsi:type="VisualizerMapping" />
      <Expression xsi:type="imvizui:ImPlotVisualizerBuilder" />
      <Expression xsi:type="rx:PublishSubject">
        <Name>PlotFrame</Name>
      </Expression>
      <Expression xsi:type="ui:VisualizerWindow">
        <ui:Text>SlapVisualizer</ui:Text>
        <ui:Visible>true</ui:Visible>
        <ui:Location xsi:nil="true" />
        <ui:Size>
          <ui:Width>900</ui:Width>
          <ui:Height>820</ui:Height>
        </ui:Size>
        <ui:WindowState xsi:nil="true" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="3" Label="Source1" />
      <Edge From="1" To="3" Label="Source2" />
      <Edge From="2" To="3" Label="Source3" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>